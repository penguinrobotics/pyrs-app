# Server Configuration
# Use port 3000 when running behind Caddy (Caddy binds ports 80/443 and proxies here)
PORT=3000

# VEX Tournament Manager Server Configuration
VEX_TM_BASE_URL=http://server.pyrs.ca

# Offline mode - set to 'true' to use static data and disable auto-dequeue
OFFLINE_MODE=false

# Caddy Reverse Proxy & Let's Encrypt (Cloudflare DNS-01)
CADDY_DOMAIN=pyrs.penguinrobotics.ca
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
