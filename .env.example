# Server Configuration
# Use port 3000 when running behind Caddy (Caddy binds ports 80/443 and proxies here)
PORT=3000

# VEX Tournament Manager Server Configuration
VEX_TM_BASE_URL=http://server.pyrs.ca

# Offline mode - set to 'true' to use static data and disable auto-dequeue
OFFLINE_MODE=false

# Caddy Reverse Proxy & Let's Encrypt (Namecheap DNS-01)
CADDY_DOMAIN=queue.pyrs.ca
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=your_namecheap_api_key
# Optional: pin a specific whitelisted public IPv4 (auto-detected if omitted in caddy/Caddyfile)
# NAMECHEAP_CLIENT_IP=
